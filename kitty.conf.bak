# Text editor
editor /usr/bin/nvim

# --- Colors ---
#background_opacity 0.95
##background_blur 10
background_image /home/jhonny/Imágenes/backgrounds/XFCE_Wallpaper_24.png
#background_image_layout scaled
background_tint 0.75

# --- Window Layout ---
initial_window_width 1720
initial_window_height 900
window_border_width 2 pt
active_border_color #00ff00
inactive_text_alpha 0.75
confirm_os_window_close 0
remember_window_size  no
window_padding_width 5
enabled_layouts tall,*
draw_minimal_borders yes
hide_window_decorations no
#background_opacity 0.80
dynamic_background_opacity yes
background_blur 65
#remember_window_size yes
window_margin_width 7
single_window_margin_width 0

# --- Fonts ---
font_size 13
text_composition_strategy 1.7 0
disable_ligatures never
modify_font cell_height 110%


# --- Cursor ---
cursor_shape beam
cursor_bean_thickness 1.7
shell_integration enabled no-cursor
cursor_blink_interval 0.5
cursor_trail 250
cursor_trail_decay 0.1 0.4
cursor_trail_start_threshold 2


# BEGIN_KITTY_FONTS
font_family      family='JetBrainsMono Nerd Font' style='Light Italic'
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS



# --- Keyboard Shortcuts ---
map ctrl+shift+f launch --stdin-source=@screen_scrollback --type=overlay fzf --no-sort --exact --tac --bind "enter:execute(xsel --primary <<< {}; notify-send copied! {})"
#map ctrl+shift+f2 launch --type=tab nvim ~/.config/kitty/kitty.conf
#map kitty_mod+period next_tab
#map kitty_mod+comma previous_tab
map kitty_mod+s show_scrollback
map ctrl+shift+t new_tab
map ctrl+shift+q close_tab
map ctrl+shift+right next_tab
map ctrl+shift+left previous_tab
map ctrl+shift+enter new_window
map ctrl+shift+w close_window
map ctrl+shift+up scroll_line_up
map ctrl+shift+down scroll_line_down
map ctrl+shift+page_up scroll_page_up
map ctrl+shift+page_down scroll_page_down
map ctrl+shift+equal change_font_size all +2.0
map ctrl+shift+minus change_font_size all -2.0
map ctrl+shift+backspace change_font_size all 0
map ctrl+shift+c copy_to_clipboard
map ctrl+shift+v paste_from_clipboard
map ctrl+shift+{ previous_window
map ctrl+shift+} next_window

# --- Mouse Mappings ---
mouse_map right click ungrabbed paste_from_clipboard


# --- Tab Bar ---
tab_bar_edge bottom
tab_bar_style powerline
#tab_powerline_style angled
tab_bar_min_tabs 2
tab_activity_symbol "● "
tab_title_template " {index}:{f'{title[:6]}…{title[-6:]}' if title.rindex(title[-1]) + 1 > 25 else title}{' []' if layout_name == 'stack' else ''} "
active_tab_foreground #261c00
active_tab_background #fcba03
active_tab_font_style normal

inactive_tab_foreground #666666
inactive_tab_background #2f3133
inactive_tab_font_style normal

tab_bar_margin_width 0.0
tab_bar_margin_color #f59f16
tab_bar_margin_height 0.0 1.0

#shell /usr/bin/fish

# --- Scrollback ---
scrollback_lines 20000
scrollback_pager bat --paging=always --italic-text=always --color=always
scrollback_pager_history_size 10

# --- Mouse ---
url_prefixes ftp ssh http https git irc sftp # Prefijos de URLs a detectar
show_hyperlink_targets yes
copy_on_select clipboard
strip_trailing_spaces smart
focus_follows_mouse yes
mouse_hide_wait -3.0

# --- Bell ---
enable_audio_bell no
visual_bell_duration 0.2
# visual_bell_color #ff5555
bell_on_tab yes
